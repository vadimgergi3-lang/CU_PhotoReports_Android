# Образ для локальной сборки APK — повторяет окружение GitHub Actions.
# Python 3.11 (как в workflow) + JDK 17 + весь toolchain Buildozer.
FROM python:3.11-bookworm

ENV DEBIAN_FRONTEND=noninteractive
# То же исправление, что и в workflow: aclocal должен видеть
# макросы libtool (LT_SYS_SYMBOL_USCORE) при сборке libffi.
ENV ACLOCAL_PATH=/usr/share/aclocal

RUN apt-get update && apt-get install -y --no-install-recommends \
      git zip unzip openjdk-17-jdk \
      autoconf automake libtool libtool-bin m4 pkg-config \
      zlib1g-dev libncurses-dev libtinfo6 cmake \
      libffi-dev libssl-dev build-essential ccache \
      wget curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Те же версии, что и в CI.
RUN python -m pip install --upgrade pip \
 && pip install buildozer Cython==0.29.36

# Не-root пользователь с UID/GID хоста — чтобы файлы сборки
# (android/.buildozer, android/bin) были доступны на хосте без sudo,
# и чтобы p4a/buildozer не ругались на запуск от root.
ARG UID=1000
ARG GID=1000
RUN groupadd -g "${GID}" builder 2>/dev/null || groupmod -n builder "$(getent group ${GID} | cut -d: -f1)" 2>/dev/null || true \
 && useradd -m -u "${UID}" -g "${GID}" -s /bin/bash builder 2>/dev/null || true

USER builder
WORKDIR /home/builder/app
